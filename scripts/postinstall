#!/bin/bash
set -euo pipefail

readonly HA_ROOT="/opt/homeassistant"
readonly HA_VENV="$HA_ROOT/venv"
readonly HA_CONFIG_DIR="/Library/Application Support/HomeAssistant"
readonly HA_CONFIG_FILE="$HA_CONFIG_DIR/config/configuration.yaml"
readonly HA_LOG_DIR="/Library/Logs/HomeAssistant"
readonly UPDATER_LOG_DIR="/Library/Logs/HomeAssistant-Installer"
readonly LAUNCHD_PLIST="/Library/LaunchDaemons/org.homeassistant.daemon.plist"
readonly UPDATER_PLIST="/Library/LaunchDaemons/org.homeassistant.updater.plist"
readonly USER_NAME="_homeassistant"
readonly GROUP_NAME="_homeassistant"
readonly SERVICE_LABEL="system/org.homeassistant.daemon"

log() { echo "[HomeAssistant installer] $*" >&2; }
fail() { log "ERROR: $*"; exit 1; }

log "Configuring Home Assistant (installer vVERSION_PLACEHOLDER)"

if [[ ! -x /opt/homebrew/bin/ffmpeg && ! -x /usr/local/bin/ffmpeg ]]; then
  log "WARNING: ffmpeg is not installed. Integrations that need transcoding may not work; install it with Homebrew (brew install ffmpeg)."
fi

id "$USER_NAME" >/dev/null 2>&1 || fail "Service account $USER_NAME does not exist"
[[ -x "$HA_VENV/bin/hass" ]] || fail "Home Assistant executable is missing: $HA_VENV/bin/hass"
[[ -x "$HA_VENV/bin/python" ]] || fail "Bundled Python interpreter is missing or broken"
"$HA_VENV/bin/python" --version >&2 || fail "Bundled Python runtime cannot start on this Mac"
[[ -f "$LAUNCHD_PLIST" ]] || fail "LaunchDaemon plist is missing: $LAUNCHD_PLIST"
[[ -f "$UPDATER_PLIST" ]] || fail "Updater LaunchDaemon plist is missing: $UPDATER_PLIST"

# Ensure the daemon's immutable application files cannot be changed by the
# service account. Only configuration and logs are writable by that account.
chown -R root:wheel "$HA_ROOT"
chmod -R go-w "$HA_ROOT"

mkdir -p "$HA_CONFIG_DIR/config" "$HA_LOG_DIR" "$UPDATER_LOG_DIR"
chown root:wheel "$UPDATER_LOG_DIR"
chmod 750 "$UPDATER_LOG_DIR"
chown -R "$USER_NAME:$GROUP_NAME" "$HA_CONFIG_DIR" "$HA_LOG_DIR"
find "$HA_CONFIG_DIR" -type d -exec chmod 750 {} +
find "$HA_CONFIG_DIR" -type f -exec chmod 640 {} +
find "$HA_LOG_DIR" -type d -exec chmod 750 {} +
find "$HA_LOG_DIR" -type f -exec chmod 640 {} +

# Never overwrite or silently modify an existing user configuration.
if [[ ! -e "$HA_CONFIG_FILE" ]]; then
  cat > "$HA_CONFIG_FILE" <<'YAML'
# Minimal Home Assistant configuration. Finish setup at http://localhost:8123.
default_config:
YAML
  chown "$USER_NAME:$GROUP_NAME" "$HA_CONFIG_FILE"
  chmod 640 "$HA_CONFIG_FILE"
fi

# A bad YAML file should not result in an endless launchd crash/restart loop.
# Run the built-in configuration check as the same unprivileged account as HA.
if ! sudo -u "$USER_NAME" "$HA_VENV/bin/hass" --script check_config --config "$HA_CONFIG_DIR/config"; then
  fail "Home Assistant configuration check failed; service was not started. Fix $HA_CONFIG_FILE and run: sudo launchctl bootstrap system $LAUNCHD_PLIST"
fi

rm -f "$HA_CONFIG_DIR/config/.ha_run.lock"
chown root:wheel "$LAUNCHD_PLIST" "$UPDATER_PLIST"
chmod 644 "$LAUNCHD_PLIST" "$UPDATER_PLIST"

launchctl bootout system "$UPDATER_PLIST" >/dev/null 2>&1 || true
launchctl bootout system "$LAUNCHD_PLIST" >/dev/null 2>&1 || true
launchctl bootout "$SERVICE_LABEL" >/dev/null 2>&1 || true
launchctl enable "$SERVICE_LABEL"
launchctl bootstrap system "$LAUNCHD_PLIST"
launchctl enable system/org.homeassistant.updater
launchctl bootstrap system "$UPDATER_PLIST"

log "Installation completed. Home Assistant is starting; open http://localhost:8123 after startup."
log "Configuration: $HA_CONFIG_DIR/config"
log "Logs: $HA_LOG_DIR"

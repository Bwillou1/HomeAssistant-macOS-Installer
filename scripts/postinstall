#!/bin/bash
set -euo pipefail

HA_CONFIG_DIR="/Library/Application Support/HomeAssistant"
HA_LOG_DIR="/Library/Logs/HomeAssistant"
HA_CONFIG_FILE="$HA_CONFIG_DIR/config/configuration.yaml"
HA_BIN_PATH="/opt/homeassistant/bin/hass"
LAUNCHD_PLIST="/Library/LaunchDaemons/org.homeassistant.daemon.plist"
USER_NAME="_homeassistant"
GROUP_NAME="_homeassistant"

echo "[INFO] Configuration Home Assistant Desktop for macOS" >&2

mkdir -p "$HA_CONFIG_DIR/config"
mkdir -p "$HA_LOG_DIR"

# Attribution des droits au nouvel utilisateur système
chown -R $USER_NAME:$GROUP_NAME "$HA_CONFIG_DIR" "$HA_LOG_DIR" >/dev/null 2>&1 || true
chmod -R 755 "$HA_CONFIG_DIR" >/dev/null 2>&1 || true
# Permissions plus restrictives pour les logs (sécurité)
chmod -R 750 "$HA_LOG_DIR" >/dev/null 2>&1 || true

# Droits sur l'installation dans /opt
if [ -d "/opt/homeassistant" ]; then
    chown -R $USER_NAME:$GROUP_NAME "/opt/homeassistant" >/dev/null 2>&1 || true
    chmod -R 755 "/opt/homeassistant" >/dev/null 2>&1 || true
fi

if [ ! -x "$HA_BIN_PATH" ]; then
  echo "[ERROR] Binaire absent ou non exécutable: $HA_BIN_PATH" >&2
  exit 1
fi

if [ ! -f "$LAUNCHD_PLIST" ]; then
  echo "[ERROR] LaunchDaemon absent: $LAUNCHD_PLIST" >&2
  exit 1
fi

# Ne pas écraser la config utilisateur existante
if [ ! -f "$HA_CONFIG_FILE" ]; then
cat > "$HA_CONFIG_FILE" << 'EOF'
# Home Assistant Configuration
homeassistant:
  name: Maison
  country: FR
  language: fr
  time_zone: Europe/Paris

default_config:

logger:
  default: info
  logs:
    homeassistant.components: debug

# Empty defaults keep Home Assistant's core script/automation setup happy.
automation: []
script: {}

# Découverte réseau
discovery:
EOF
fi

if ! grep -q '^automation:' "$HA_CONFIG_FILE"; then
cat >> "$HA_CONFIG_FILE" << 'EOF'

automation: []
EOF
fi

if ! grep -q '^script:' "$HA_CONFIG_FILE"; then
cat >> "$HA_CONFIG_FILE" << 'EOF'

script: {}
EOF
fi

chown -R $USER_NAME:$GROUP_NAME "$HA_CONFIG_DIR" >/dev/null 2>&1 || true
chmod 644 "$HA_CONFIG_FILE" >/dev/null 2>&1 || true

# Suppression du lock en cas de démarrage précédent avorté ou problème de permissions
rm -f "$HA_CONFIG_DIR/.ha_run.lock"

# Configuration des droits du LaunchDaemon
# On fait le bootout AVANT de modifier les permissions pour éviter l'état fantôme (bug 5: Input/output error)
launchctl bootout system "$LAUNCHD_PLIST" >/dev/null 2>&1 || true
launchctl bootout system/org.homeassistant.daemon >/dev/null 2>&1 || true

chown root:wheel "$LAUNCHD_PLIST"
chmod 644 "$LAUNCHD_PLIST"

# Recharge et tente de démarrer le service sans bloquer l'installation
if ! launchctl bootstrap system "$LAUNCHD_PLIST" >/dev/null 2>&1; then
  echo "[WARN] Service non démarré automatiquement. Démarrez-le manuellement avec launchctl." >&2
else
  launchctl enable system/org.homeassistant.daemon >/dev/null 2>&1 || true
  launchctl kickstart -k system/org.homeassistant.daemon >/dev/null 2>&1 || true
fi

sleep 1

if [ -f "$HA_BIN_PATH" ] && [ -f "$LAUNCHD_PLIST" ] && [ -f "$HA_CONFIG_FILE" ]; then
    echo "[INFO] Installation réussie" >&2
    echo "[INFO] Interface web: http://localhost:8123" >&2
    
    # Ouvrir automatiquement l'interface web après 30 secondes
    (
        sleep 30
        echo "[INFO] Ouverture automatique de l'interface web..." >&2
        open "http://localhost:8123" 2>/dev/null || true
    ) &
    
    # Notification macOS
    osascript -e 'display notification "Home Assistant est en cours de démarrage" with title "Home Assistant Desktop" subtitle "Interface web: http://localhost:8123"' 2>/dev/null || true
    
else
    echo "[ERROR] Installation incomplète" >&2
    exit 1
fi

exit 0

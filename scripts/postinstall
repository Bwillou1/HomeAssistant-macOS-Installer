#!/bin/bash
set -euo pipefail

HA_CONFIG_DIR="/Library/Application Support/HomeAssistant"
HA_LOG_DIR="/Library/Logs/HomeAssistant"
HA_CONFIG_FILE="$HA_CONFIG_DIR/config/configuration.yaml"
HA_BIN_PATH="/opt/homeassistant/bin/hass"
LAUNCHD_PLIST="/Library/LaunchDaemons/org.homeassistant.daemon.plist"
USER_NAME="_homeassistant"
GROUP_NAME="_homeassistant"

echo "[INFO] Configuring Home Assistant Desktop for macOS (vVERSION_PLACEHOLDER)" >&2

mkdir -p "$HA_CONFIG_DIR/config"
mkdir -p "$HA_LOG_DIR"

# Assign permissions to the new system user
chown -R $USER_NAME:$GROUP_NAME "$HA_CONFIG_DIR" "$HA_LOG_DIR"
chmod -R 755 "$HA_CONFIG_DIR" "$HA_LOG_DIR"

# Permissions on the /opt installation
if [ -d "/opt/homeassistant" ]; then
    chown -R $USER_NAME:$GROUP_NAME "/opt/homeassistant"
    chmod -R 755 "/opt/homeassistant"
fi

if [ ! -x "$HA_BIN_PATH" ]; then
  echo "[ERROR] Binary missing or not executable: $HA_BIN_PATH" >&2
  exit 1
fi

if [ ! -f "$LAUNCHD_PLIST" ]; then
  echo "[ERROR] LaunchDaemon missing: $LAUNCHD_PLIST" >&2
  exit 1
fi

# Do not overwrite existing user config
if [ ! -f "$HA_CONFIG_FILE" ]; then
# Detect system settings for default config
SYS_COUNTRY=$(defaults read .GlobalPreferences AppleLocale | cut -d'_' -f2 | cut -d'@' -f1 || echo "US")
SYS_LANG=$(defaults read .GlobalPreferences AppleLocale | cut -d'_' -f1 || echo "en")
SYS_TZ=$(sudo systemsetup -gettimezone | awk '{print $3}' || echo "UTC")

cat > "$HA_CONFIG_FILE" << EOF
# Home Assistant Configuration
homeassistant:
  name: Home Assistant
  country: $SYS_COUNTRY
  language: $SYS_LANG
  time_zone: $SYS_TZ

default_config:

logger:
  default: info
  logs:
    homeassistant.components: debug

# Empty defaults keep Home Assistant's core script/automation setup happy.
automation: []
script: {}

# Network Discovery
discovery:
EOF
fi

if ! grep -q '^automation:' "$HA_CONFIG_FILE"; then
cat >> "$HA_CONFIG_FILE" << 'EOF'

automation: []
EOF
fi

if ! grep -q '^script:' "$HA_CONFIG_FILE"; then
cat >> "$HA_CONFIG_FILE" << 'EOF'

script: {}
EOF
fi

chown -R $USER_NAME:$GROUP_NAME "$HA_CONFIG_DIR"
chmod 640 "$HA_CONFIG_FILE"

# Remove lock file in case of aborted previous start or permission issues
rm -f "$HA_CONFIG_DIR/config/.ha_run.lock"

# Configure LaunchDaemon permissions
# Bootout BEFORE modifying permissions to avoid phantom state (bug 5: Input/output error)
launchctl bootout system "$LAUNCHD_PLIST" >/dev/null 2>&1 || true
launchctl bootout system/org.homeassistant.daemon >/dev/null 2>&1 || true

chown root:wheel "$LAUNCHD_PLIST"
chmod 644 "$LAUNCHD_PLIST"

# Reload and attempt to start service without blocking installation
if ! launchctl bootstrap system "$LAUNCHD_PLIST" >/dev/null 2>&1; then
  echo "[WARN] Service did not start automatically. Start it manually with launchctl." >&2
else
  launchctl enable system/org.homeassistant.daemon >/dev/null 2>&1 || true
  launchctl kickstart -k system/org.homeassistant.daemon >/dev/null 2>&1 || true
fi

sleep 1

if [ -f "$HA_BIN_PATH" ] && [ -f "$LAUNCHD_PLIST" ] && [ -f "$HA_CONFIG_FILE" ]; then
    echo "[INFO] Installation successful" >&2
    echo "[INFO] Web interface: http://localhost:8123" >&2
    
    # macOS Notification
    osascript -e 'display notification "Home Assistant is starting up" with title "Home Assistant Desktop" subtitle "Web interface: http://localhost:8123"' 2>/dev/null || true
    
else
    echo "[ERROR] Installation incomplete" >&2
    exit 1
fi

exit 0

#!/bin/bash

# Home Assistant Desktop for macOS - Script de désinstallation
# Désinstallation complète et propre de l'application

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Fonctions de logging
log_info() {
    echo "[INFO] $1" >&2
}

log_error() {
    echo "[ERROR] $1" >&2
}

log_warning() {
    echo "[WARNING] $1" >&2
}

# Vérification permissions administrateur
if [ "$(id -u)" -ne 0 ]; then
    log_error "La désinstallation requiert les permissions administrateur"
    echo "Utilisez: sudo bash $0"
    exit 1
fi

log_info "Désinstallation Home Assistant Desktop for macOS"

# Confirmation utilisateur
read -p "Voulez-vous vraiment désinstaller Home Assistant Desktop? (o/N): " -r
if [[ ! $REPLY =~ ^[Oo]$ ]]; then
    log_info "Désinstallation annulée"
    exit 0
fi

# 1. Arrêt du service
log_info "Arrêt du service Home Assistant..."
if launchctl list | grep -q "org.homeassistant.daemon"; then
    launchctl unload -w /Library/LaunchDaemons/org.homeassistant.daemon.plist 2>/dev/null || true
    sleep 2
fi

# 2. Arrêt forcé des processus
log_info "Arrêt des processus Home Assistant..."
pkill -f "homeassistant-macos" 2>/dev/null || true
pkill -f "homeassistant" 2>/dev/null || true
pkill -f "hass" 2>/dev/null || true

# 3. Sauvegarde optionnelle de la configuration
read -p "Voulez-vous sauvegarder la configuration? (o/N): " -r
if [[ $REPLY =~ ^[Oo]$ ]]; then
    BACKUP_DIR="$HOME/Desktop/HomeAssistant-Backup-$(date +%Y%m%d-%H%M%S)"
    log_info "Sauvegarde de la configuration dans $BACKUP_DIR..."
    if [ -d "/Library/Application Support/HomeAssistant" ]; then
        mkdir -p "$BACKUP_DIR"
        cp -r "/Library/Application Support/HomeAssistant/config" "$BACKUP_DIR/" 2>/dev/null || true
        cp -r "/Library/Application Support/HomeAssistant/deps" "$BACKUP_DIR/" 2>/dev/null || true
        log_info "Configuration sauvegardée"
    fi
fi

# 4. Suppression des fichiers binaires
log_info "Suppression des fichiers binaires..."
rm -f /usr/local/bin/homeassistant-macos 2>/dev/null || true
rm -f /usr/local/bin/hass 2>/dev/null || true
rm -f /usr/local/bin/homeassistant 2>/dev/null || true

# 5. Suppression du LaunchDaemon
log_info "Suppression du service système..."
rm -f /Library/LaunchDaemons/org.homeassistant.daemon.plist 2>/dev/null || true

# 6. Suppression des répertoires de données
log_info "Suppression des répertoires de données..."
if [ -d "/Library/Application Support/HomeAssistant" ]; then
    rm -rf "/Library/Application Support/HomeAssistant" 2>/dev/null || true
fi

if [ -d "/Library/Logs/HomeAssistant" ]; then
    rm -rf "/Library/Logs/HomeAssistant" 2>/dev/null || true
fi

# 7. Suppression des fichiers de configuration système
log_info "Suppression des fichiers de configuration système..."
rm -f /usr/local/share/homeassistant/sandbox-profile.sb 2>/dev/null || true
rm -f /etc/pf.anchors/homeassistant 2>/dev/null || true

# 8. Nettoyage des permissions TCC
log_info "Nettoyage des permissions TCC..."
TCC_DB="/Library/Application Support/com.apple.TCC/TCC.db"
if [ -f "$TCC_DB" ]; then
    # Suppression des entrées Home Assistant de la base TCC
    sqlite3 "$TCC_DB" "DELETE FROM access WHERE client = 'org.homeassistant.daemon';" 2>/dev/null || true
    log_info "Permissions TCC nettoyées"
fi

# 9. Nettoyage du firewall
log_info "Nettoyage des règles du firewall..."
if [ -f "/etc/pf.conf" ]; then
    # Suppression des règles Home Assistant
    sed -i '' '/homeassistant/d' /etc/pf.conf 2>/dev/null || true
    
    # Rechargement du firewall
    pfctl -f /etc/pf.conf 2>/dev/null || true
    log_info "Règles firewall supprimées"
fi

# 10. Nettoyage des fichiers temporaires
log_info "Nettoyage des fichiers temporaires..."
rm -f /tmp/ha_notifications.log 2>/dev/null || true
rm -rf /tmp/homeassistant-* 2>/dev/null || true

# 11. Suppression des entrées launchd restantes
log_info "Nettoyage des entrées launchd..."
launchctl remove org.homeassistant.daemon 2>/dev/null || true

# 12. Vérification de la désinstallation
log_info "Vérification de la désinstallation..."

REMAINING_FILES=""

# Vérification des fichiers restants
if [ -f "/usr/local/bin/homeassistant-macos" ]; then
    REMAINING_FILES="$REMAINING_FILES /usr/local/bin/homeassistant-macos"
fi

if [ -f "/Library/LaunchDaemons/org.homeassistant.daemon.plist" ]; then
    REMAINING_FILES="$REMAINING_FILES /Library/LaunchDaemons/org.homeassistant.daemon.plist"
fi

if [ -d "/Library/Application Support/HomeAssistant" ]; then
    REMAINING_FILES="$REMAINING_FILES /Library/Application Support/HomeAssistant"
fi

if [ -d "/Library/Logs/HomeAssistant" ]; then
    REMAINING_FILES="$REMAINING_FILES /Library/Logs/HomeAssistant"
fi

if [ -n "$REMAINING_FILES" ]; then
    log_warning "Certains fichiers n'ont pas pu être supprimés:"
    echo "$REMAINING_FILES"
    log_warning "Vous pouvez les supprimer manuellement si nécessaire"
else
    log_info "Désinstallation terminée avec succès"
fi

# 13. Nettoyage final
log_info "Nettoyage final..."
# Suppression des entrées crontab éventuelles
crontab -l 2>/dev/null | grep -v homeassistant | crontab - 2>/dev/null || true

# Suppression des services utilisateurs éventuels
for user in $(ls /Users); do
    if [ -f "/Users/$user/Library/LaunchAgents/org.homeassistant.agent.plist" ]; then
        rm -f "/Users/$user/Library/LaunchAgents/org.homeassistant.agent.plist"
        su - "$user" -c "launchctl unload -w ~/Library/LaunchAgents/org.homeassistant.agent.plist" 2>/dev/null || true
    fi
done

log_info "Home Assistant Desktop for macOS a été désinstallé"
log_info "Redémarrez votre Mac pour finaliser la désinstallation"

exit 0

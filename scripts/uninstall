#!/bin/bash
set -euo pipefail

readonly HA_ROOT="/opt/homeassistant"
readonly HA_DATA="/Library/Application Support/HomeAssistant"
readonly HA_LOGS="/Library/Logs/HomeAssistant"
readonly UPDATER_LOGS="/Library/Logs/HomeAssistant-Installer"
readonly LAUNCHD_PLIST="/Library/LaunchDaemons/org.homeassistant.daemon.plist"
readonly UPDATER_PLIST="/Library/LaunchDaemons/org.homeassistant.updater.plist"
readonly SERVICE_LABEL="system/org.homeassistant.daemon"

log() { echo "[HomeAssistant uninstall] $*" >&2; }
usage() {
  cat <<'EOF'
Usage: sudo /opt/homeassistant/uninstall [--keep-config | --remove-config] [--non-interactive]

Default: remove the Home Assistant runtime and service, preserve configuration.
--keep-config       Preserve configuration and logs.
--remove-config     Permanently remove Home Assistant configuration and logs.
--non-interactive   Do not prompt; configuration is preserved unless --remove-config is set.
EOF
}

[[ "$(id -u)" -eq 0 ]] || { log "Run with sudo."; exit 1; }

MODE="preserve"
MODE_SET=false
NON_INTERACTIVE=false
while (($#)); do
  case "$1" in
    --keep-config)
      [[ "$MODE_SET" == false || "$MODE" == "preserve" ]] || { usage >&2; exit 2; }
      MODE="preserve"; MODE_SET=true ;;
    --remove-config)
      [[ "$MODE_SET" == false || "$MODE" == "remove" ]] || { usage >&2; exit 2; }
      MODE="remove"; MODE_SET=true ;;
    --non-interactive) NON_INTERACTIVE=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

if [[ "$MODE" == "remove" && "$NON_INTERACTIVE" == false ]]; then
  echo "This permanently deletes: $HA_DATA, $HA_LOGS, $UPDATER_LOGS and /Library/Application Support/HomeAssistant-Backups" >&2
  read -r -p 'Type REMOVE to confirm data deletion: ' confirmation
  [[ "$confirmation" == "REMOVE" ]] || { log "Cancelled; no data removed."; exit 0; }
fi

log "Stopping only this Home Assistant LaunchDaemon and updater..."
launchctl bootout system/org.homeassistant.updater >/dev/null 2>&1 || true
launchctl bootout system "$UPDATER_PLIST" >/dev/null 2>&1 || true
launchctl bootout "$SERVICE_LABEL" >/dev/null 2>&1 || true
launchctl bootout system "$LAUNCHD_PLIST" >/dev/null 2>&1 || true
launchctl disable system/org.homeassistant.updater >/dev/null 2>&1 || true

log "Removing Home Assistant runtime and LaunchDaemons..."
rm -rf "$HA_ROOT"
rm -f "$LAUNCHD_PLIST" "$UPDATER_PLIST"

if [[ "$MODE" == "remove" ]]; then
  log "Removing Home Assistant configuration and logs as explicitly requested."
  rm -rf "$HA_DATA" "$HA_LOGS" "$UPDATER_LOGS" "/Library/Application Support/HomeAssistant-Backups"
else
  log "Configuration, updater backups and logs preserved at: $HA_DATA, /Library/Application Support/HomeAssistant-Backups, $HA_LOGS and $UPDATER_LOGS"
fi

log "Uninstallation complete. The restricted _homeassistant account is left in place to avoid deleting a pre-existing account."

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.homeassistant.daemon</string>

    <key>UserName</key>
    <string>_homeassistant</string>

    <key>GroupName</key>
    <string>_homeassistant</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homeassistant/venv/bin/hass</string>
        <string>-c</string>
        <string>/Library/Application Support/HomeAssistant/config</string>
        <string>--log-file</string>
        <string>/Library/Logs/HomeAssistant/home-assistant.log</string>
        <string>--log-rotate-days</string>
        <string>7</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>Umask</key>
    <integer>23</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Library/Logs/HomeAssistant/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/HomeAssistant/daemon.error.log</string>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/HomeAssistant</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homeassistant/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>FFMPEG_HWACCEL</key>
        <string>videotoolbox</string>
        <key>HOME</key>
        <string>/Library/Application Support/HomeAssistant</string>
        <key>UV_CACHE_DIR</key>
        <string>/Library/Application Support/HomeAssistant/.cache/uv</string>
        <key>SUPERVISOR</key>
        <string>127.0.0.1:8765</string>
        <key>SUPERVISOR_TOKEN</key>
        <string>SUPERVISOR_TOKEN_PLACEHOLDER</string>
        <key>SETUP_PORT</key>
        <string>8123</string>
    </dict>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>32768</integer>
    </dict>
</dict>
</plist>

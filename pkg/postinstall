#!/bin/bash

# Home Assistant Desktop for macOS - Post-installation script simplifié
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_PATH="$3"
HA_CONFIG_DIR="/Library/Application Support/HomeAssistant"
HA_LOG_DIR="/Library/Logs/HomeAssistant"
HA_BIN_PATH="/usr/local/bin/homeassistant-macos"
LAUNCHD_PLIST="/Library/LaunchDaemons/org.homeassistant.daemon.plist"

# Logging function
log_info() {
    echo "[INFO] $1" >&2
}

log_error() {
    echo "[ERROR] $1" >&2
}

log_info "Configuration Home Assistant Desktop for macOS"

# 1. Création répertoires système
log_info "Création répertoires système..."
mkdir -p "$HA_CONFIG_DIR"
mkdir -p "$HA_LOG_DIR"
mkdir -p "$HA_CONFIG_DIR/config"

# 2. Configuration permissions de base
log_info "Configuration permissions..."
chown -R root:wheel "$HA_CONFIG_DIR" 2>/dev/null || true
chown -R root:wheel "$HA_LOG_DIR" 2>/dev/null || true
chmod -R 755 "$HA_CONFIG_DIR" 2>/dev/null || true
chmod -R 755 "$HA_LOG_DIR" 2>/dev/null || true

# 3. Installation binaire
log_info "Installation binaire..."
if [ -f "$INSTALL_PATH/homeassistant-macos" ]; then
    cp "$INSTALL_PATH/homeassistant-macos" "$HA_BIN_PATH"
    chmod +x "$HA_BIN_PATH"
    chown root:wheel "$HA_BIN_PATH" 2>/dev/null || true
else
    log_error "Binaire non trouvé"
    exit 1
fi

# 4. Installation LaunchDaemon
log_info "Configuration service système..."
if [ -f "$INSTALL_PATH/org.homeassistant.daemon.plist" ]; then
    cp "$INSTALL_PATH/org.homeassistant.daemon.plist" "$LAUNCHD_PLIST"
    chmod 644 "$LAUNCHD_PLIST"
    chown root:wheel "$LAUNCHD_PLIST" 2>/dev/null || true
else
    log_error "LaunchDaemon non trouvé"
    exit 1
fi

# 5. Configuration initiale simple
log_info "Configuration initiale..."
cat > "$HA_CONFIG_DIR/config/configuration.yaml" << 'EOF'
# Home Assistant Configuration
homeassistant:
  name: Maison
  country: FR
  language: fr
  time_zone: Europe/Paris

logger:
  default: info
  logs:
    homeassistant.components: debug

# Découverte réseau
discovery:

# Intégrations système
sensor:
  - platform: systemmonitor
    resources:
      - type: memory_use_percent
      - type: processor_use
      - type: disk_use_percent
        arg: /
      - type: network_in
      - type: network_out
      - type: last_boot
      - type: load_1m
      - type: load_5m
      - type: load_15m
EOF

chown root:wheel "$HA_CONFIG_DIR/config/configuration.yaml" 2>/dev/null || true
chmod 644 "$HA_CONFIG_DIR/config/configuration.yaml" 2>/dev/null || true

# 6. Démarrage service (optionnel)
log_info "Démarrage service Home Assistant..."
if command -v launchctl >/dev/null 2>&1; then
    launchctl load -w "$LAUNCHD_PLIST" 2>/dev/null || log_info "Service déjà configuré"
fi

# 7. Vérification finale
log_info "Vérification installation..."
sleep 2

if [ -f "$HA_BIN_PATH" ] && [ -f "$LAUNCHD_PLIST" ] && [ -f "$HA_CONFIG_DIR/config/configuration.yaml" ]; then
    log_info "Installation réussie !"
    log_info "Interface web: http://localhost:8123"
    log_info "Logs: $HA_LOG_DIR"
    log_info "Configuration: $HA_CONFIG_DIR/config"
else
    log_error "Installation incomplète"
    exit 1
fi

# 8. Nettoyage
rm -rf "$INSTALL_PATH"

log_info "Installation terminée avec succès"
exit 0
